---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const POSTER =
  'https://customer-wa9cpywo3l4jte5c.cloudflarestream.com/a43755aabf7c31ea830b32dcce95b2a1/thumbnails/thumbnail.jpg?time=&height=600';

const {
  title = 'Essence Waxing Studio | Refined Brazilian Waxing',
  description = 'An elegant waxing studio concept for Brazilian and sensitive-area hard wax. Smooth results for 3 to 4 weeks. Domain available.',
  ogImage = POSTER,
} = Astro.props;

const canonical =
  Astro.props.canonical ?? new URL(Astro.url.pathname, Astro.site).toString();

const siteName = 'Essence Waxing Studio';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <meta name="google-site-verification" content="i6UMzhT4OvHEhgRfKk0gaS8Fo1p3VHsxu6dsh1aK65k" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2e1c19" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": "https://essencewaxingstudio.com",
      "description": description
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": title,
      "description": description,
      "url": canonical,
      "primaryImageOfPage": { "@type": "ImageObject", "url": ogImage },
      "datePublished": "2026-09-13",
      "dateModified": "2026-09-13"
    })} />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
  </body>
</html>
